---
import { getRelativeLocaleUrl } from 'astro:i18n';
import { normalizeLocale } from '../i18n';
import type { InfonodeKey } from '../lib/infonodes';

interface Props {
    type: InfonodeKey;
    id: string;
}
const locale = normalizeLocale(Astro.currentLocale);
const p = Astro.props;
---

<a href={getRelativeLocaleUrl(locale, `${p.type}/${p.id}`)}></a>
