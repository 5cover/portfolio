---
import type { Infonode, InfonodeKey } from '../lib/infonodes';
import type { PropsBase } from '../lib/types';
import ProjectCard from './project/Card.astro';
import PianoTileCard from './pianoTile/Card.astro';

interface Props<C extends InfonodeKey> extends PropsBase {
    of: Infonode<C>;
}
const { c, of } = Astro.props;

const components = {
    project: ProjectCard,
    pianoTile: PianoTileCard,
} as const;
const Component = components[of.type];
---

<Component {c} {of} />
