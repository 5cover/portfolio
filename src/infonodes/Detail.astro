---
import type { HasDetail, Infonode, InfonodeKey } from '../lib/content';
import type { PropsBase } from '../lib/types';
import ProjectDetail from './project/Detail.astro';

interface Props<C extends InfonodeKey & HasDetail = HasDetail> extends PropsBase {
    of: Infonode<C>;
}
const { c, of } = Astro.props;

const components = {
    project: ProjectDetail,
} as const;
const Component = components[of.type];
---

<Component {c} {of} />
