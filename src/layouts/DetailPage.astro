---
import BaseLayout from './BaseLayout.astro';
import { get, type HasDetail, type InfonodeKey } from '../lib/infonodes';
import type { Context } from '../lib/types';
import Detail from '../infonodes/Detail.astro';

type Props = {
    of: InfonodeKey & HasDetail;
    id: string;
};

const { of, id } = Astro.props;
---

<BaseLayout pageName={`${of}/${id}`}>
    {(c: Context) => <Detail {c} of={get[of](Astro.currentLocale, id)} />}
</BaseLayout>
