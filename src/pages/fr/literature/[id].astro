---
import LiteratureDetailPage from '../../../components/pages/LiteratureDetailPage.astro';
import { getCollection } from 'astro:content';
import '../../../styles/literature.scss';
import { get } from '../../../lib/infonodes';
export async function getStaticPaths() {
    return (await getCollection('literature')).map(({ id }) => ({ params: { id } }));
}
---

<LiteratureDetailPage of={get.literature(Astro.currentLocale, Astro.params.id)} />
