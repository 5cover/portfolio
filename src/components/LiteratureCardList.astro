---
import type { Entry, LocalizedItem } from '../lib/content';
import LiteratureCard from './LiteratureCard.astro';
interface Props {
    entries: readonly Entry<LocalizedItem<'literature'>>[];
}

const { entries } = Astro.props;
---

<ul class='lvl list-detail-split-card'>
    {entries.map(entry => <LiteratureCard entry={entry} />)}
</ul>
