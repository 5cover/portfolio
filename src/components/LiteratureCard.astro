---
import Graphic from './Graphic';
import LinkList from './LinkList.astro';
import { detailHref } from '../lib/links';
import { translation, normalizeLocale } from '../i18n';
import Copy from './Copy.astro';
import Heading from './Heading.astro';
import type { PropsBase } from '../lib/types';
import type { Infonode } from '../lib/content';

interface Props extends PropsBase {
    of: Infonode<'literature'>;
}

const {
    c,
    of: { id, data },
} = Astro.props;
const locale = normalizeLocale(Astro.currentLocale);
const logoTitle = translation(locale).logoTitle(data.title.toString());
const backgroundStyle = data.background ? `--bg-img-card: url(${data.background})` : undefined;
---

<li id={id} style={backgroundStyle}>
    {data.logo ? <Graphic of={data.logo} alt={logoTitle} title={logoTitle} class='logo' /> : null}
    <div>
        <Heading {c}>
            <a class='foil' href={detailHref(locale, 'literature', id)}>
                <Copy of={data.title} />
            </a>
        </Heading>
        <p class='abstract'>=<Copy of={data.abstract} /></p>
        {data.links.length > 0 ? <LinkList links={data.links} /> : null}
    </div>
</li>
