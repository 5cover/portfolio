---
import { normalizeLocale } from '../i18n';
import { copy } from '../lib/copy';
import Copy from './Copy.astro';
import Graphic from './Graphic';
import { translation } from '../i18n';
import { defType } from '../catalog/def-type';
import type { Infonode } from '../lib/infonodes';

function buildDefTitle(def: Infonode<'def'>) {
    const { abbr, full } = def.data.name;
    return abbr ? copy([full, ' (', { title: full.toString(), abbr }, ')']) : full;
}

interface Props {
    def: Infonode<'def'>;
}
const { def } = Astro.props;
const { data } = def;
const defTitle = buildDefTitle(def);
const logoTitle = translation(Astro.currentLocale).logoTitle(defTitle.toString());
const backgroundStyle = data.background ? `--bg-img-card: url(${data.background})` : undefined;

const typeName = defType(normalizeLocale(Astro.currentLocale), data.type).title;
---

<article class='def' style={backgroundStyle}>
    <h4>
        <a class='foil' target='_blank' rel='noopener noreferrer' href={data.wiki}>
            <Copy of={defTitle} />
        </a>
    </h4>
    {data.logo ? <Graphic of={data.logo} title={logoTitle} class='logo' /> : null}
    <p class='type'><small><Copy of={typeName.capitalize()} /></small></p>
    <p class='synopsis'><Copy of={data.synopsis} /></p>
</article>
