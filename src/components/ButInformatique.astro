---
import { normalizeLocale } from '../i18n';
import ButInformatiqueBody from './but/Body';
const locale = normalizeLocale(Astro.currentLocale);
const { default: copy } = await import(`./but/${locale}.ts`);
---

<ButInformatiqueBody locale={locale} d={copy}>
    <slot />
</ButInformatiqueBody>
<script src='../../src/scripts/but.ts'></script>
