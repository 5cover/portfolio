---
import type { Infonode } from '../lib/content';
import DefCard from './DefCard.astro';

interface Props {
    defs: readonly Infonode<'def'>[];
}
const { defs } = Astro.props;
---

<ul class='lvl list-def'>
    {
        defs.map(def => (
            <li>
                <DefCard def={def} />
            </li>
        ))
    }
</ul>
