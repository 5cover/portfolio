---
import { anchors } from '../catalog/anchor';
import type { Reference } from '../content.config';
import { translation, type Localize } from '../i18n';
import Copy from './Copy.astro';
import Graphic from './Graphic';

type Props = {
    references: readonly Localize<Reference>[];
};

const { references } = Astro.props;
const _ = translation(Astro.currentLocale);
---

<ol class='list'>
    {
        references.map((ref, index) => {
            const num = index + 1;
            const anchor = anchors[ref.anchor];
            return (
                <li id={`ref-${num}`}>
                    <span class='ref-backlink' aria-label={_.refJumpUp} title={_.refJumpUp}>
                        <a class='link' href={`#cite-ref-${num}`}>
                            &uarr;
                        </a>
                    </span>
                    <a class='ref-cite link' target='_blank' rel='noopener noreferrer' href={ref.href}>
                        <Graphic of={anchor} alt={ref.caption.toString()} />
                        <span>
                            <Copy of={ref.caption} />
                        </span>
                    </a>
                </li>
            );
        })
    }
</ol>
