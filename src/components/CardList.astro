---
import style from './CardList.module.scss';
export interface Props {
    items: readonly unknown[];
}
export interface Slots {
    default: [unknown];
}
const p = Astro.props;
const slots = await Promise.all(p.items.map(item => Astro.slots.render('default', [item] satisfies Slots['default'])));
---

<ul class={style.cardList}>
    {slots.forEach(html => <li set:html={html} />)}
</ul>
