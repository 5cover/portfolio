---
import { cls } from '../../lib/util';

interface Props {
    href: string;
    external?: boolean;
    class?: string;
}

const { href, external, class: className } = Astro.props;

if (!href) {
    throw new Error('TextLink requires an href');
}

const isExternal = (external ?? href.startsWith('http://')) || href.startsWith('https://');
---

<a href={href} class:list={['link', className]} {...isExternal ? { target: '_blank', rel: 'noopener noreferrer' } : {}}>
    <slot />
</a>
