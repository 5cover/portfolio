---
import type { Infonode } from '../../lib/infonodes';
import * as content from '../../lib/content';

interface Props {
    of: InfonodeType;
    id: string;
}

const { of, id } = Astro.props;

const node = content[of](Astro.currentLocale, id);
---

<a href={href} class:list={['link']} {...isExternal ? { target: '_blank', rel: 'noopener noreferrer' } : {}}>
    <slot />
</a>
