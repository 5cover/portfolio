---
import BaseLayout from '../../layouts/BaseLayout
import TextualContent from '../TextualContent.astro';
import Gallery from '../Gallery.astro';
import Graphic from '../Graphic';
import LinkList from '../LinkList';
import ReferenceList from '../ReferenceList.astro';
import * as content from '../../lib/content';
import { translation, normalizeLocale } from '../../i18n';
import Copy from '../Copy.astro';

interface Props {
    id: string;
    mainClass?: string;
}
const { id, mainClass } = Astro.props;

const locale = normalizeLocale(Astro.currentLocale);
const _ = translation(locale);
const data = content.literature(locale, id);
const body = await content.textual(locale, 'literature', id);
const backgroundStyle = data.background ? `--bg-img: url(${data.background})` : undefined;
---

<BaseLayout pageName={`literature/${id}`}>
    <main style={backgroundStyle} class={mainClass}>
        <header>
            <h1><Copy c={data.title} /></h1>
            {data.logo ? <Graphic of={data.logo} title={_.logoTitle(data.title.toString())} class='logo' /> : null}
            <p class='abstract'><Copy c={data.abstract} /></p>
        </header>
        {
            data.links.length > 0 ? (
                <section id='links'>
                    <h2>{_.links}</h2>
                    <LinkList links={data.links} variant='page' />
                </section>
            ) : null
        }
        <section id='story'>
            <h2>{_.story}</h2>
            <TextualContent content={body} />
        </section>
        {
            data.references.length > 0 ? (
                <section id='references'>
                    <h2>{_.references}</h2>
                    <ReferenceList references={data.references} />
                </section>
            ) : null
        }
        {
            data.gallery.length > 0 ? (
                <section id='gallery'>
                    <h2>{_.gallery}</h2>
                    <Gallery items={data.gallery} />
                </section>
            ) : null
        }
    </main>
</BaseLayout>
