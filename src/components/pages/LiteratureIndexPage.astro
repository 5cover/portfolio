---
import { normalizeLocale, translation, type LiteratureKind } from '../../i18n';
import BaseLayout from '../../layouts/BaseLayout
import * as content from '../../lib/content';
import LiteratureCardList from '../LiteratureCardList.astro';

interface Props {
    kind: LiteratureKind;
    mainClass?: string;
}

const { kind, mainClass } = Astro.props;
const locale = normalizeLocale(Astro.currentLocale);
const { nav } = translation(locale);
const entries = content.literature(locale).filter(([, lit]) => lit.kind === kind);
---

<BaseLayout pageName={kind}>
    <main class={mainClass}>
        <h1>{nav[kind]}</h1>
        <LiteratureCardList entries={entries} />
    </main>
</BaseLayout>
