---
import type { LiteratureKind } from '../../const';
import { normalizeLocale, translation } from '../../i18n';
import BaseLayout from '../../layouts/BaseLayout.astro';
import * as content from '../../lib/content';
import type { Context } from '../../lib/types';
import LiteratureCardList from '../LiteratureCardList.astro';

interface Props {
    kind: LiteratureKind;
    mainClass?: string;
}

const p = Astro.props;
const locale = normalizeLocale(Astro.currentLocale);
const { nav } = translation(locale);
const entries = content.literature(locale).filter(({ data }) => data.kind === p.kind);
---

<BaseLayout pageName={p.kind}
    >{
        (c: Context) => (
            <main class={p.mainClass}>
                <h1>{nav[p.kind]}</h1>
                <LiteratureCardList {c} of={entries} />
            </main>
        )
    }</BaseLayout
>
