---
import BaseLayout from '../../layouts/BaseLayout.astro';
import TextualContent from '../TextualContent.astro';
import DefCardList from '../DefCardList.astro';
import Gallery from '../Gallery.astro';
import Graphic from '../Graphic';
import LinkList from '../LinkList';
import ReferenceList from '../ReferenceList.astro';

import * as content from '../../lib/content';
import { pageHref } from '../../lib/links';
import { translation, normalizeLocale } from '../../i18n';

import '../../styles/project.scss';
import { formatDate } from '../../lib/util';
import { copy } from '../../lib/copy';
import tags, { localizeTag } from '../../catalog/tag';
import Copy from '../Copy.astro';

interface Props {
    id: string;
}

const { id } = Astro.props;

const locale = normalizeLocale(Astro.currentLocale);

const _ = translation(locale);

const p = content.project(locale, id);
const projectBody = await content.textual(locale, 'project', id);

const backgroundStyle = p.background ? `--bg-img: url(${p.background})` : undefined;
const title = copy(p.title);
const logoTitle = _.logoTitle(title.toString());
const startLabel = p.startDate ? formatDate(p.startDate, locale) : '';
const endLabel = p.endDate ? formatDate(p.endDate, locale) : '';
const context = p.context ? copy(p.context).capitalize() : undefined;
const teamDefs = p.team.map(({ id }) => content.def(locale, id));
const techDefs = p.technologies.map(({ id }) => content.def(locale, id));
---

<BaseLayout pageName={`project/${id}`}>
    <main style={backgroundStyle}>
        <header>
            <ul class='list-rect'>
                {
                    p.tags.map(tagId => (
                        <li>
                            <a href={`${pageHref(locale, 'projects')}?tag=${tagId}`}>
                                <Copy c={copy(localizeTag(locale)(tags[tagId]).title)} />
                            </a>
                        </li>
                    ))
                }
            </ul>
            <h1><Copy c={copy(p.title)} /></h1>
            {p.logo ? <Graphic of={p.logo} alt={logoTitle} title={logoTitle} class='logo' /> : null}
            <p class='abstract'><Copy c={copy(p.abstract)} /></p>
            <div class='status-context'>
                {
                    context ? (
                        <small class='context'>
                            <Copy c={context} />
                        </small>
                    ) : null
                }
                {
                    p.startDate ? (
                        <small class='status'>
                            <time datetime={p.startDate.toISOString()}>{startLabel}</time> &ndash;{' '}
                            {p.endDate ? <time datetime={p.endDate.toISOString()}>{endLabel}</time> : _.ongoing}
                        </small>
                    ) : null
                }
            </div>
        </header>
        {
            p.links.length > 0 ? (
                <section id='links'>
                    <h2>{_.links}</h2>
                    <LinkList links={p.links} variant='page' />
                </section>
            ) : null
        }
        {
            teamDefs.length > 0 ? (
                <section id='team'>
                    <h2>{_.team}</h2>
                    <DefCardList defs={teamDefs} />
                </section>
            ) : null
        }
        <section id='story'>
            <h2>{_.story}</h2>
            <TextualContent content={projectBody} />
        </section>
        {
            p.references.length > 0 ? (
                <section id='references'>
                    <h2>{_.references}</h2>
                    <ReferenceList references={p.references} />
                </section>
            ) : null
        }
        {
            techDefs.length > 0 ? (
                <section id='technologies'>
                    <h2>{_.technologies}</h2>
                    <DefCardList defs={techDefs} />
                </section>
            ) : null
        }
        {
            p.gallery.length > 0 ? (
                <section id='gallery'>
                    <h2>{_.gallery}</h2>
                    <Gallery items={p.gallery} />
                </section>
            ) : null
        }
    </main>
</BaseLayout>
