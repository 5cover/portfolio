---
import type { Infonode } from '../lib/content';
import type { PropsBase } from '../lib/types';
import ProjectCard from './ProjectCard.astro';

interface Props extends PropsBase {
    class?: string;
    of: readonly Infonode<'project'>[];
}
const { c, ...p } = Astro.props;
---

<ul class:list={['lvl', 'list-project', p.class]}>
    {p.of.map(project => <ProjectCard {c} of={project} />)}
</ul>
