---
import { copy } from '../lib/copy';
import { isArray } from '../lib/util';
import Badge from './Badge';
import Def from './mdx/Def.astro';
type Props = {
    of: copy;
};
const of = copy(Astro.props.of).copy;
---

{
    of === null ? null : typeof of === 'string' ? (
        <>{of}</>
    ) : isArray(of) ? (
        of.map(of => <Astro.self {of} />)
    ) : of.t === 'badge' ? (
        <Badge of={of.p.key} lang={of.p.lang}>
            <Astro.self of={of.c} />
        </Badge>
    ) : of.t === 'copy' ? (
        <Astro.self of={of.c} />
    ) : of.t === 'def' ? (
        <Def id={of.p} />
    ) : of.t === 'a' ? (
        <a {...of.p} class='link' target='_blank' rel='noopener noreferrer'>
            <Astro.self of={of.c} />
        </a>
    ) : (
        <of.t {...of.p}>
            <Astro.self of={of.c} />
        </of.t>
    )
}
