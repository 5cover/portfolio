---
import type { GalleryItem } from '../content.config';
import type { Localize } from '../i18n';
import Copy from './Copy.astro';

interface Props {
    items: readonly Localize<GalleryItem>[];
}

const { items } = Astro.props;
---

<ul class='lvl gallery'>
    {
        items.map((item, index) => {
            return (
                <li>
                    <figure id={`gallery-${index + 1}`} class='figure'>
                        {item.src ? (
                            <img
                                src={item.src}
                                alt={item.caption.toString()}
                                title={item.caption.toString()}
                                loading='lazy'
                            />
                        ) : item.iframeSrc ? (
                            <iframe
                                src={item.iframeSrc}
                                loading='lazy'
                                width='300'
                                height='300'
                                title={item.caption.toString()}
                            />
                        ) : item.content ? (
                            <Fragment set:html={item.content} />
                        ) : null}
                        <figcaption>
                            <Copy c={item.caption} />
                        </figcaption>
                    </figure>
                </li>
            );
        })
    }
</ul>
