---
import Graphic from './Graphic';
import LinkList from './LinkList.astro';
import { detailHref, pageHref } from '../lib/links';
import { normalizeLocale, translation } from '../i18n';
import { formatDate } from '../lib/util';
import { copy } from '../lib/copy';
import { tag } from '../catalog/tag';
import Heading from './Heading.astro';
import Section from './Section.astro';
import type { PropsBase, Context } from '../lib/types';
import Copy from './Copy.astro';
import type { Infonode } from '../lib/content';

interface Props extends PropsBase {
    of: Infonode<'project'>;
}
const {
    c,
    of: { id, data },
} = Astro.props;
const locale = normalizeLocale(Astro.currentLocale);
const _ = translation(locale);
const logoTitle = _.logoTitle(data.title.toString());
const startLabel = data.startDate ? formatDate(data.startDate, locale) : null;
const endLabel = data.endDate ? formatDate(data.endDate, locale) : null;
const context = data.context ? copy(data.context).capitalize() : null;
const backgroundStyle = data.background ? `--bg-img-card: url(${data.background})` : undefined;
---

<Section {c} as='li' style={backgroundStyle}
    >{
        (c: Context) => (
            <>
                <ul class='list-rect'>
                    {data.tags.map(tagId => (
                        <li>
                            <a href={`${pageHref(locale, 'projects')}?tag=${tagId}`}>
                                <Copy of={tag(locale, tagId).title} />
                            </a>
                        </li>
                    ))}
                </ul>
                {data.logo ? <Graphic of={data.logo} alt={logoTitle} title={logoTitle} class='logo' /> : null}
                <Heading {c}>
                    <a class='foil' href={detailHref(locale, 'projects', id)}>
                        <Copy of={data.title} />
                    </a>
                </Heading>
                {data.startDate ? (
                    <small class='status'>
                        <time datetime={data.startDate.toISOString()}>{startLabel}</time> &ndash;{' '}
                        {data.endDate ? <time datetime={data.endDate.toISOString()}>{endLabel}</time> : _.ongoing}
                    </small>
                ) : null}
                {context ? <small class='context'>{context}</small> : null}
                <p class='abstract'>{data.abstract}</p>
                {data.links.length > 0 ? <LinkList links={data.links} /> : null}
            </>
        )
    }</Section
>
